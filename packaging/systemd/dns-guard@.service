[Unit]
Description=DNS Guard instance %i
Documentation=https://github.com/sahip9211/dns-guard
After=network.target

[Service]
Type=exec
# Provision a distinct account and encrypted credential for each instance first.
User=dns-guard-%i
Group=dns-guard-%i
StateDirectory=dns-guard/%i
StateDirectoryMode=0700
UMask=0077
LoadCredentialEncrypted=data-key:/etc/dns-guard/%i/data-key.cred
ExecStart=/usr/bin/dns-guard serve --config /var/lib/dns-guard/%i/settings.sqlite --key-file %d/data-key
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitCORE=0

[Install]
WantedBy=multi-user.target
